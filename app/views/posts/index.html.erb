<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Ruby 게시판 연습</a>
    <% if user_signed_in? %>
      <div class="d-flex justify-content-center align-items-center">
        <p>어서오세요, <%= current_user.email %>님</p> &nbsp;
        <%= button_to "로그아웃", destroy_user_session_path, method: :delete, class: "nav-link" %>
      </div>
    <% else %>
       <a class="nav-link" href="/users/sign_in">로그인</a>
    <% end %>
  </div>
</nav>

<% if user_signed_in? %>
  <div class="padding-2">
    <a href="/posts/new" class="btn btn-primary">작성하기</a>
  </div>
<% end %>

<div class="mt-3 table-responsive">
  <table class="table table-hover align-middle">
    <colgroup>
      <col style="width: 10%">
      <col style="width: 45%">
      <col style="width: 15%">
      <col style="width: 20%">
      <col style="width: 10%">
    </colgroup>

    <thead>
      <tr class="text-center">
        <th scope="col"></th>
        <th scope="col">제목</th>
        <th scope="col">작성자</th>
        <th scope="col">업로드 일자</th>
        <th scope="col">댓글</th>
      </tr>
    </thead>

    <tbody>
      <%# <% @posts.each do |post| %>
      <% @posts.each_with_index do |post, index| %>
      <tr class="text-center">
        <td><%= index + 1%></td>
        <td class="text-start">
            <a href="/posts/show/<%= post.id %>" class="text-decoration-none text-dark"><%= post.title %></a>
        </td>
        <td><%= post.user.email %></td>
        <td><%= post.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= post.comments.count() %></td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>
