<div class="p-3">
    <h1>게시글 작성</h1>
    <form action="/posts/create" method="POST">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <div class="mb-3">
            <div class="mb-1">제목</div>
            <input type="text" name="input_title" class="form-control" placeholder="제목 작성하기">
        </div>
        <div class="mb-3">
            <div class="mb-1">내용</div>
            <textarea name="input_content" rows="3" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            작성
        </button>
    </form>
</div>